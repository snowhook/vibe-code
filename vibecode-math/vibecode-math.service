[Unit]
Description=vibecode-math standalone service (/api/math/* on 127.0.0.1:5101)
After=network.target

[Service]
Type=simple
User=admin
Group=admin
WorkingDirectory=/home/admin/apps/vibecode-math
Environment=PYTHONUSERBASE=/home/admin/.local
ExecStart=/usr/bin/python3 /home/admin/apps/vibecode-math/math_app.py
Restart=always
RestartSec=3
StandardOutput=append:/var/log/vibecode-math.log
StandardError=append:/var/log/vibecode-math.log

[Install]
WantedBy=multi-user.target
