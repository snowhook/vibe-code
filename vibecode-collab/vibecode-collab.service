[Unit]
Description=vibecode-collab standalone service (/api/collab/* on 127.0.0.1:5103)
After=network.target

[Service]
Type=simple
User=admin
Group=admin
WorkingDirectory=/home/admin/apps/vibecode-collab
Environment=PYTHONUSERBASE=/home/admin/.local
ExecStart=/usr/bin/python3 /home/admin/apps/vibecode-collab/collab_app.py
Restart=always
RestartSec=3
StandardOutput=append:/var/log/vibecode-collab.log
StandardError=append:/var/log/vibecode-collab.log

[Install]
WantedBy=multi-user.target
