[Unit]
Description=vibecode-bazi standalone service (/api/bazi/* on 127.0.0.1:5100)
After=network.target

[Service]
Type=simple
User=admin
Group=admin
WorkingDirectory=/home/admin/apps/vibecode-bazi
Environment=PYTHONUSERBASE=/home/admin/.local
ExecStart=/usr/bin/python3 /home/admin/apps/vibecode-bazi/bazi_app.py
Restart=always
RestartSec=3
StandardOutput=append:/var/log/vibecode-bazi.log
StandardError=append:/var/log/vibecode-bazi.log

[Install]
WantedBy=multi-user.target
