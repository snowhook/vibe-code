[Unit]
Description=vibecode-aigen standalone service (/api/aigen + /api/proxy + /api/aikit on 127.0.0.1:5106)
After=network.target

[Service]
Type=simple
User=admin
Group=admin
WorkingDirectory=/home/admin/apps/vibecode-aigen
Environment=PYTHONUSERBASE=/home/admin/.local
ExecStart=/usr/bin/python3 /home/admin/apps/vibecode-aigen/aigen_app.py
Restart=always
RestartSec=3
StandardOutput=append:/var/log/vibecode-aigen.log
StandardError=append:/var/log/vibecode-aigen.log

[Install]
WantedBy=multi-user.target
