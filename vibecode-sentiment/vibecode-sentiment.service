[Unit]
Description=vibecode-sentiment standalone service (/api/sentiment/* on 127.0.0.1:5105)
After=network.target

[Service]
Type=simple
User=admin
Group=admin
WorkingDirectory=/home/admin/apps/vibecode-sentiment
Environment=PYTHONUSERBASE=/home/admin/.local
ExecStart=/usr/bin/python3 /home/admin/apps/vibecode-sentiment/sentiment_app.py
Restart=always
RestartSec=3
StandardOutput=append:/var/log/vibecode-sentiment.log
StandardError=append:/var/log/vibecode-sentiment.log

[Install]
WantedBy=multi-user.target
