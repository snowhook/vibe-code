[Unit]
Description=vibecode-lockup standalone service (/api/lockup/* on 127.0.0.1:5104)
After=network.target

[Service]
Type=simple
User=admin
Group=admin
WorkingDirectory=/home/admin/apps/vibecode-lockup
Environment=PYTHONUSERBASE=/home/admin/.local
ExecStart=/usr/bin/python3 /home/admin/apps/vibecode-lockup/lockup_app.py
Restart=always
RestartSec=3
StandardOutput=append:/var/log/vibecode-lockup.log
StandardError=append:/var/log/vibecode-lockup.log

[Install]
WantedBy=multi-user.target
